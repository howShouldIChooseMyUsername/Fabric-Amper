# Keep Windows launchers runnable with Windows line endings.
*.bat text eol=crlf
*.ps1 text eol=crlf

# Normalize portable source and documentation.
*.kt text eol=lf
*.kts text eol=lf
*.java text eol=lf
*.properties text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.xml text eol=lf
*.py text eol=lf

# Binary artifacts should not be normalized.
*.jar binary
*.zip binary
*.png binary
*.jpg binary
*.webp binary
